#!/usr/bin/env python3
"""Interactively save, update, and delete Ptyxis terminal layouts."""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

SCRIPT_DIRECTORY = Path(__file__).resolve().parent
sys.path[:0] = [str(SCRIPT_DIRECTORY / concern) for concern in ("layout", "ptyxis")
                if (SCRIPT_DIRECTORY / concern).is_dir()]

from Layout import Layout
from LayoutStore import LayoutStore
from TermlayError import TermlayError
from current_layout import current_layout
from layout_paths import validate_name
from ptyxis_tabs import read_current_tab_titles

VERSION = "0.3.0"


def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser(prog="termlay", description=__doc__)
    result.add_argument("--version", action="version", version=f"termlay {VERSION}")
    commands = result.add_subparsers(dest="command", required=True)
    commands.add_parser("save", help="select current Ptyxis tabs and save a new layout")
    commands.add_parser("update", help="select a saved layout and replace its tabs")
    commands.add_parser("delete", help="select saved layouts to delete")
    return result


def ask(prompt: str) -> str:
    try:
        return input(prompt).strip()
    except (EOFError, KeyboardInterrupt) as error:
        raise TermlayError("selection cancelled") from error


def select_items(items: list[str], label: str, multiple: bool = True) -> list[int]:
    print(f"{label}:")
    for index, item in enumerate(items, 1):
        print(f"  {index}. {item}")
    while True:
        prompt = ("Select numbers separated by commas, 'all', or 'q' to cancel: "
                  if multiple else "Select one number or 'q' to cancel: ")
        answer = ask(prompt).lower()
        if answer in {"q", "quit"}:
            return []
        if multiple and answer == "all":
            return list(range(len(items)))
        try:
            indices = [int(piece.strip()) - 1 for piece in answer.split(",")]
            if (not indices or (not multiple and len(indices) != 1)
                    or any(index < 0 or index >= len(items) for index in indices)):
                raise ValueError
            return list(dict.fromkeys(indices))
        except ValueError:
            print("Enter listed numbers, 'all', or 'q'." if multiple
                  else "Enter one listed number or 'q'.")


def selected_tabs() -> list[str]:
    titles = read_current_tab_titles()
    if not titles:
        raise TermlayError("no Ptyxis tabs found")
    indices = select_items(titles, "Current Ptyxis tabs")
    return [titles[index] for index in sorted(indices)]


def selected_names(store: LayoutStore, multiple: bool = True) -> list[str]:
    names = store.list_names()
    if not names:
        raise TermlayError("no saved layouts")
    return [names[index] for index in select_items(names, "Saved layouts", multiple)]


def confirmed(prompt: str) -> bool:
    return ask(f"{prompt} [y/N] ").lower() in {"y", "yes"}


def main(argv: list[str] | None = None) -> int:
    argv = sys.argv[1:] if argv is None else argv
    if argv and not argv[0].startswith("-") and argv[0] not in {"save", "update", "delete"}:
        print(f"termlay: unknown command '{argv[0]}'\nRun 'termlay --help' for usage.", file=sys.stderr)
        return 2
    args = parser().parse_args(argv)
    if not sys.stdin.isatty():
        raise TermlayError(f"{args.command} requires an interactive terminal")
    store = LayoutStore()
    if args.command == "save":
        titles = selected_tabs()
        if not titles:
            print("Save cancelled")
            return 0
        name = ask("New layout name (blank cancels): ")
        if not name:
            print("Save cancelled")
            return 0
        validate_name(name)
        if name in store.list_names():
            raise TermlayError(f"layout '{name}' already exists; use 'termlay update' to replace it")
        layout = current_layout(name, titles)
        store.save(layout)
        print(f"Saved layout '{name}' ({len(layout.directories)} tabs)")
    elif args.command == "update":
        names = selected_names(store, multiple=False)
        if not names:
            print("Update cancelled")
            return 0
        titles = selected_tabs()
        if not titles:
            print("Update cancelled")
            return 0
        captured = current_layout(names[0], titles)
        print("Selected directories:")
        for directory in captured.directories:
            print(f"  {directory}")
        if not confirmed(f"Replace {names[0]} with these tabs?"):
            print("Update cancelled")
            return 0
        name = names[0]
        store.replace(Layout(name, captured.directories))
        print(f"Updated layout '{name}' ({len(captured.directories)} tabs)")
    else:
        names = selected_names(store)
        if not names or not confirmed(f"Delete {', '.join(names)}?"):
            print("Delete cancelled")
            return 0
        for name in names:
            store.delete(name)
            print(f"Deleted layout '{name}'")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, TermlayError) as error:
        print(f"termlay: {error}", file=sys.stderr)
        sys.exit(1)
