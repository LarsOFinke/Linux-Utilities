{
  "display_name": "Ubuntu automatic updates",
  "category": "Server services",
  "subcategory": "Package maintenance",
  "description": "unattended upgrade policy and status",
  "schema_version": 1,
  "id": "ubuntu-updates",
  "setup": "setup.sh",
  "documentation": "README.md",
  "commands": {
    "ubuntu-updates": "scripts/ubuntu_updates.sh",
    "ubuntu-updates-configure": "scripts/ubuntu_updates_workflow.sh",
    "ubuntu-updates-status": "scripts/ubuntu_updates_workflow.sh",
    "ubuntu-updates-logs": "scripts/ubuntu_updates_workflow.sh",
    "ubuntu-updates-dry-run": "scripts/ubuntu_updates_workflow.sh",
    "ubuntu-updates-run": "scripts/ubuntu_updates_workflow.sh",
    "ubuntu-updates-restore": "scripts/ubuntu_updates_workflow.sh",
    "ubuntu_updates_state.sh": "scripts/ubuntu_updates_state.sh",
    "ubuntu_updates_policy.sh": "scripts/ubuntu_updates_policy.sh",
    "ubuntu_updates_actions.sh": "scripts/ubuntu_updates_actions.sh"
  },
  "non_executable_commands": [
    "ubuntu_updates_state.sh",
    "ubuntu_updates_policy.sh",
    "ubuntu_updates_actions.sh"
  ],
  "examples": [],
  "cron_templates": [],
  "runtime_configs": {
    "system": [
      "etc/apt/apt.conf.d/99-shell-scripts-unattended-upgrades",
      "var/lib/shell-scripts/ubuntu-updates/state.cfg"
    ]
  },
  "pre_remove": {
    "command": "ubuntu-updates-restore",
    "args": ["--yes"],
    "root_env": "UU_ROOT"
  },
  "scopes": [
    "system"
  ]
}
