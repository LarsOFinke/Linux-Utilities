#!/usr/bin/env python3
"""Manage named fs-tracker systemd services owned by Linux-Utilities."""

import argparse
import json
import os
import subprocess
import sys
from pathlib import Path

from canary_lifecycle import configure, remove_one
from canary_state import ROOT, STATE, fail, record_for, systemctl, verify_owned


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)
    setup = commands.add_parser("configure")
    setup.add_argument("name")
    setup.add_argument("--path", required=True)
    setup.add_argument("--log", required=True)
    setup.add_argument("--action")
    for command in ("status", "start", "stop", "remove"):
        item = commands.add_parser(command)
        item.add_argument("name")
        if command == "remove":
            item.add_argument("--yes", action="store_true")
    all_item = commands.add_parser("remove-all")
    all_item.add_argument("--yes", action="store_true")
    args = parser.parse_args()
    if ROOT == Path("/") and os.geteuid() != 0:
        fail("run canary-control as root")
    if args.command == "configure":
        configure(args)
    elif args.command == "remove-all":
        if not args.yes:
            fail("remove-all requires --yes")
        records = [record_for(path.stem) for path in sorted(STATE.glob("*.json"))] if STATE.exists() else []
        for record in records:
            verify_owned(record)
        for record in records:
            remove_one(record)
    else:
        record = record_for(args.name)
        unit = f"fs-file-monitor-{args.name}.service"
        if args.command == "remove":
            if not args.yes:
                fail("remove requires --yes")
            remove_one(record)
        else:
            verify_owned(record)
            if args.command == "status":
                print(json.dumps(record, indent=2))
                systemctl("status", unit)
            elif args.command == "start":
                systemctl("enable", "--now", unit)
            elif args.command == "stop":
                systemctl("disable", "--now", unit)


if __name__ == "__main__":
    try:
        main()
    except (OSError, RuntimeError, subprocess.CalledProcessError, json.JSONDecodeError) as error:
        print(f"canary-control: {error}", file=sys.stderr)
        sys.exit(1)
