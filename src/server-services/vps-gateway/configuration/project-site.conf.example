# Compatibility example. New projects can use configuration/blueprints/http-app.conf.example.
server {
    server_tokens off;
    listen 80;
    listen [::]:80;
    server_name app.example.org;

    limit_req zone=gateway_per_ip burst=60 nodelay;
    limit_req zone=gateway_per_site burst=100;
    limit_conn gateway_conn_per_ip 50;

    location / {
        include /etc/nginx/snippets/vps-gateway-proxy-headers.conf;
        proxy_set_header Connection "";
        proxy_pass http://127.0.0.1:18081;
    }
}
