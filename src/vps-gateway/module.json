{
  "display_name": "NGINX and Certbot setup",
  "category": "Server services",
  "description": "distribution NGINX and Certbot bootstrap for a VPS",
  "schema_version": 1,
  "id": "vps-gateway",
  "setup": "setup.sh",
  "documentation": "README.md",
  "commands": {
    "vps-gateway": "scripts/vps-gateway",
    "vps-gateway-site": "scripts/vps-gateway-site.py"
  },
  "build_commands": {
    "vps-gateway-site": "scripts/build-site-command.py"
  },
  "post_install": {
    "command": "vps-gateway-site",
    "args": ["init"],
    "prompt": "Set up the first VPS gateway site now?"
  },
  "examples": [
    "configuration/project-site.conf.example",
    "configuration/core/nginx.conf.example",
    "configuration/core/http.conf.example",
    "configuration/core/proxy-headers.conf.example",
    "configuration/core/catch-all.conf.example",
    "configuration/blueprints/http-app.conf.example",
    "configuration/blueprints/java-spring.conf.example",
    "configuration/blueprints/python-asgi.conf.example",
    "configuration/blueprints/websocket.conf.example",
    "configuration/blueprints/static-html.conf.example",
    "configuration/blueprints/spa.conf.example"
  ],
  "cron_templates": [],
  "scopes": [
    "system"
  ]
}
